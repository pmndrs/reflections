{
    "$schema": "https://typedoc.org/schema.json",
    "name": "@pmndrs/reflections",
    "entryPoints": ["src/three.ts", "src/core.ts", "src/babylon.ts", "src/pixi.ts"],
    "tsconfig": "tsconfig.json",
    "out": "api-docs",
    "readme": "none",
    "favicon": "tools/favicon.svg",
    "includeVersion": false,
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "excludeExternals": true,
    "exclude": ["**/*.test.ts"],
    "sort": ["kind", "alphabetical"],
    "navigationLinks": {
        "Docs": "https://pmndrs.github.io/reflections/",
        "Examples": "https://pmndrs.github.io/reflections/examples/",
        "GitHub": "https://github.com/pmndrs/reflections"
    },
    "validation": {
        "notExported": false,
        "invalidLink": false,
        "rewrittenLink": false,
        "unusedMergeModuleWith": false
    },
    "treatWarningsAsErrors": false
}
