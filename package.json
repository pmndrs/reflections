{
  "name": "@pmndrs/reflections",
  "version": "0.1.0",
  "description": "Reflections for WebGPU: reflection probes (box-projected, prefiltered), screen-space reflections and ray-traced fallbacks, composed into one hybrid. Engine-agnostic core, three.js adapter.",
  "author": "Dennis Smolek <dennis@smolek.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/reflections.git"
  },
  "homepage": "https://github.com/pmndrs/reflections#readme",
  "bugs": {
    "url": "https://github.com/pmndrs/reflections/issues"
  },
  "keywords": [
    "three",
    "threejs",
    "webgpu",
    "wgsl",
    "tsl",
    "reflections",
    "reflection-probes",
    "ssr",
    "sssr",
    "screen-space-reflections",
    "ray-tracing",
    "hybrid",
    "pmrem",
    "octahedral",
    "babylonjs",
    "pixi",
    "pixijs"
  ],
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js",
      "default": "./dist/three.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./babylon": {
      "types": "./dist/babylon.d.ts",
      "import": "./dist/babylon.js",
      "default": "./dist/babylon.js"
    },
    "./pixi": {
      "types": "./dist/pixi.d.ts",
      "import": "./dist/pixi.js",
      "default": "./dist/pixi.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "three": [
        "./dist/three.d.ts"
      ],
      "core": [
        "./dist/core.d.ts"
      ],
      "babylon": [
        "./dist/babylon.d.ts"
      ],
      "pixi": [
        "./dist/pixi.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "examples": "vite --config examples/vite.config.ts",
    "examples:build": "vite build --config examples/vite.config.ts",
    "check": "node scripts/run-headless.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "build": "vite build && rollup -c rollup.dts.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs:api": "typedoc",
    "docs:snippets": "node tools/docs-snippets.ts",
    "docs:check": "node tools/docs-snippets.ts --check && node tools/examples-doc.ts --check && tsc -p tsconfig.snippets.json",
    "docs:examples": "node tools/examples-doc.ts",
    "docs:site": "node tools/docs-site.ts",
    "site:build": "node tools/site-build.ts",
    "site:check": "node tools/site-check.ts",
    "settings:doc": "UPDATE_SETTINGS_DOC=1 vitest run test/settings-doc.test.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "node scripts/pack-manifest.mjs strip",
    "postpack": "node scripts/pack-manifest.mjs restore"
  },
  "peerDependencies": {
    "@babylonjs/core": ">=9.35.0 <10",
    "@pmndrs/bvh": "^0.1.0",
    "@pmndrs/raytracer": "^0.1.0",
    "pixi.js": ">=8.22.0 <9",
    "three": ">=0.187.0"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": {
      "optional": true
    },
    "@pmndrs/bvh": {
      "optional": true
    },
    "@pmndrs/raytracer": {
      "optional": true
    },
    "pixi.js": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjs/core": "9.35.0",
    "@pmndrs/bvh": "^0.1.0",
    "@pmndrs/pathtracer": "^0.1.0",
    "@pmndrs/raytracer": "^0.1.0",
    "@pmndrs/reflections-babylon": "workspace:*",
    "@pmndrs/reflections-core": "workspace:*",
    "@pmndrs/reflections-pixi": "workspace:*",
    "@pmndrs/reflections-three": "workspace:*",
    "@pmndrs/upscaler": "0.5.0",
    "@react-three/fiber": "10.0.0-alpha.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@webgpu/types": "^0.1.71",
    "denoiser": "^2.0.0",
    "meshoptimizer": "^1.3.0",
    "pixi.js": "8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.2.1",
    "three": "^0.187.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
