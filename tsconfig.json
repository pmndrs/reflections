{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@pmndrs/reflections": ["src/index.ts"],
      "@pmndrs/reflections/three": ["src/three.ts"],
      "@pmndrs/reflections/core": ["src/core.ts"],
      "@pmndrs/reflections/babylon": ["src/babylon.ts"],
      "@pmndrs/reflections/pixi": ["src/pixi.ts"]
    }
  },
  "include": ["src", "packages/*/src", "examples", "test"],
  "exclude": ["node_modules", "dist", "examples/dist", "examples/vite.config.ts"]
}
